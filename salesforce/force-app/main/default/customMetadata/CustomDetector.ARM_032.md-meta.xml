<?xml version="1.0" encoding="UTF-8"?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" fqn="CustomDetector__mdt.ARM_032">
    <label>ARM-032</label>
    <protected>false</protected>
    <values><field>DetectorId__c</field><value xsi:type="xsd:string">ARM-032</value></values>
    <values><field>Label__c</field><value xsi:type="xsd:string">Asset past lifecycle end date</value></values>
    <values><field>Category__c</field><value xsi:type="xsd:string">governance</value></values>
    <values><field>AppliesTo__c</field><value xsi:type="xsd:string">ARM</value></values>
    <values><field>SoqlQuery__c</field><value xsi:type="xsd:string">SELECT Id, Name, Status, CurrentLifecycleEndDate FROM Asset WHERE Status = 'Active' AND CurrentLifecycleEndDate &lt; TODAY</value></values>
    <values><field>TitleTemplate__c</field><value xsi:type="xsd:string">Asset &quot;{Name}&quot; past lifecycle end ({CurrentLifecycleEndDate}) but still Active</value></values>
    <values><field>DescriptionTemplate__c</field><value xsi:type="xsd:string">Active assets whose CurrentLifecycleEndDate is in the past should be moved to a terminal state or have their dates extended.</value></values>
    <values><field>PrimaryRecordIdField__c</field><value xsi:type="xsd:string">Id</value></values>
    <values><field>PrimaryRecordType__c</field><value xsi:type="xsd:string">Asset</value></values>
    <values><field>EntitledUsdField__c</field><value xsi:nil="true"/></values>
    <values><field>RealizedUsdField__c</field><value xsi:nil="true"/></values>
    <values><field>IsActive__c</field><value xsi:type="xsd:boolean">true</value></values>
    <values><field>Version__c</field><value xsi:type="xsd:double">1</value></values>
    <values><field>Effort__c</field><value xsi:type="xsd:string">low</value></values>
    <values><field>RecoverabilityScore__c</field><value xsi:type="xsd:double">1.0</value></values>
    <values><field>Severity__c</field><value xsi:type="xsd:string">Info</value></values>
    <values><field>LongDescription__c</field><value xsi:type="xsd:string">Finds: Asset records in Active status whose CurrentLifecycleEndDate is in the past.
Why it matters: Assets past their lifecycle end keep billing — customers pay for service that should have ended. Or, if billing already stopped but the asset&apos;s still Active, downstream reporting shows wrong revenue.
Suppress a finding: when an extension is in flight.
Disable the detector: leave on.</value></values>
</CustomMetadata>
