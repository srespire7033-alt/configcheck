    <values><field>SoqlQuery__c</field><value xsi:type="xsd:string">SELECT Id, Name FROM blng__BillingRule__c WHERE Id NOT IN (SELECT blng__BillingRule__c FROM Product2 WHERE blng__BillingRule__c != null)</value></values>
    <values><field>TitleTemplate__c</field><value xsi:type="xsd:string">Billing rule &quot;{Name}&quot; is not referenced by any product</value></values>
    <values><field>DescriptionTemplate__c</field><value xsi:type="xsd:string">Billing rule is not assigned to any product. It may be a legacy or test rule that can be archived to reduce admin clutter.</value></values>
