    <values><field>DetectorId__c</field><value xsi:type="xsd:string">BR-003</value></values>
    <values><field>Label__c</field><value xsi:type="xsd:string">Unused (orphan) billing rules</value></values>
    <values><field>Category__c</field><value xsi:type="xsd:string">governance</value></values>
