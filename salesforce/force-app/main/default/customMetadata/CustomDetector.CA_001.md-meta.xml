    <values><field>DetectorId__c</field><value xsi:type="xsd:string">CA-001</value></values>
    <values><field>Label__c</field><value xsi:type="xsd:string">Configuration attribute hidden AND required</value></values>
    <values><field>Category__c</field><value xsi:type="xsd:string">governance</value></values>
    <values><field>AppliesTo__c</field><value xsi:type="xsd:string">CPQ;CPQ+Billing</value></values>
    <values><field>SoqlQuery__c</field><value xsi:type="xsd:string">SELECT Id, Name FROM SBQQ__ConfigurationAttribute__c WHERE SBQQ__Required__c = true AND SBQQ__Hidden__c = true</value></values>
    <values><field>TitleTemplate__c</field><value xsi:type="xsd:string">Attribute &quot;{Name}&quot; is both hidden and required</value></values>
    <values><field>DescriptionTemplate__c</field><value xsi:type="xsd:string">Configuration attribute is marked as Required but also Hidden. Users cannot see or fill in a hidden field, making it impossible to configure the product.</value></values>
    <values><field>PrimaryRecordIdField__c</field><value xsi:type="xsd:string">Id</value></values>
